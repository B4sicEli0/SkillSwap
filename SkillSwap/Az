#include <stdio.h>
#include <stdlib.h>
#include <pthread.h>
#include <unistd.h>

void* thread_func(void* arg) {
    int id = *(int*)arg;

    for (int i = 1; i <= 4; i++) {
        sleep(1);
        printf("Thread %d: iterazione %d - in esecuzione\n", id, i);
    }

    return NULL;
}

int main() {
    pthread_t tid[3];
    pthread_attr_t attr;
    int ids[3] = {1, 2, 3};

    pthread_attr_init(&attr);
    pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);

    for (int i = 0; i < 3; i++) {
        pthread_create(&tid[i], &attr, thread_func, &ids[i]);
    }

    pthread_attr_destroy(&attr);

    printf("main: uscita\n");

    // fondamentale!
    pthread_exit(NULL);
}
