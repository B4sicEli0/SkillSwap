#include <stdio.h>
#include <pthread.h>

#define THREADS 4
#define ITER 250000

long somma = 0;

void* thread_func(void* arg) {
    for (long i = 0; i < ITER; i++) {
        somma += i;  // NON PROTETTO
    }
    return NULL;
}

int main() {
    pthread_t tid[THREADS];

    for (int i = 0; i < THREADS; i++) {
        pthread_create(&tid[i], NULL, thread_func, NULL);
    }

    for (int i = 0; i < THREADS; i++) {
        pthread_join(tid[i], NULL);
    }

    printf("Somma: %ld\n", somma);

    return 0;
}
